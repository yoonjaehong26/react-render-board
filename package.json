{
  "name": "react-render-board",
  "description": "React 앱의 실시간 렌더 트리를 박스+선 다이어그램 캔버스로 시각화하는 dev-only 도구",
  "version": "0.2.5",
  "license": "MIT",
  "author": "yoonjaehong26",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yoonjaehong26/react-render-board.git"
  },
  "homepage": "https://github.com/yoonjaehong26/react-render-board#readme",
  "bugs": {
    "url": "https://github.com/yoonjaehong26/react-render-board/issues"
  },
  "keywords": [
    "react",
    "devtools",
    "fiber",
    "component-tree",
    "visualization",
    "react-flow",
    "dev-tool",
    "vite-plugin",
    "webpack-plugin"
  ],
  "type": "module",
  "main": "./dist-lib/index.js",
  "module": "./dist-lib/index.js",
  "types": "./dist-lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/index.d.ts",
      "import": "./dist-lib/index.js"
    },
    "./inject": {
      "types": "./dist-lib/inject.d.ts",
      "import": "./dist-lib/inject.js"
    },
    "./vite": "./cli/vite.mjs",
    "./webpack": "./cli/webpack.cjs",
    "./style.css": "./dist-lib/index.css"
  },
  "bin": {
    "react-render-board": "cli/bin.mjs"
  },
  "files": [
    "dist-lib",
    "cli"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "prepublishOnly": "npm run build:lib && npm run verify:matrix",
    "postinstall": "node cli/postinstall.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:demo": "tsc -b && NODE_ENV=development vite build --mode development --minify false --sourcemap true",
    "typecheck": "tsc -b",
    "build:lib": "node -e \"require('node:fs').rmSync('dist-lib',{recursive:true,force:true})\" && tsc -p tsconfig.lib.json && vite build --config vite.lib.config.ts",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "node scripts/verify.mjs",
    "verify:high-frequency": "node scripts/verify-high-frequency.mjs",
    "verify:dom-interaction": "node scripts/verify-dom-interaction.mjs",
    "verify:props-flow": "node scripts/verify-props-flow.mjs",
    "verify:edge-clutter": "node scripts/verify-edge-clutter.mjs",
    "verify:edge-lineage": "node scripts/verify-edge-lineage.mjs",
    "verify:edge-frame-fallback": "node scripts/verify-edge-frame-fallback.mjs",
    "verify:edge-routing": "node scripts/verify-edge-routing.mjs",
    "verify:init": "node scripts/verify-init.mjs",
    "verify:init-next": "node scripts/verify-init-next.mjs",
    "verify:init-next-canvas": "node scripts/verify-init-next-canvas.mjs",
    "verify:init-webpack": "node scripts/verify-init-webpack.mjs",
    "verify:init-rspack": "node scripts/verify-init-rspack.mjs",
    "verify:matrix": "node scripts/verify-matrix.mjs"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.2",
    "bippy": "^0.6.0",
    "roughjs": "^4.6.6"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "playwright": "^1.61.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}

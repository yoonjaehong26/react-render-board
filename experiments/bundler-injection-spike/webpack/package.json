{
  "name": "webpack-injection-spike",
  "version": "1.0.0",
  "private": true,
  "description": "Spike: webpack plugin auto-injects instrumentation script into HTML served by webpack-dev-server, without touching app source.",
  "scripts": {
    "dev": "webpack serve --config webpack.config.js",
    "build": "webpack --config webpack.config.js"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.1.0",
    "html-webpack-plugin": "^5.6.0",
    "typescript": "^5.5.4",
    "ts-loader": "^9.5.1",
    "playwright": "^1.61.1"
  }
}

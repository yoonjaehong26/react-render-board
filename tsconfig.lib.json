{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.lib.tsbuildinfo",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "rootDir": "./src",
    "outDir": "./dist-lib"
  },
  "include": ["src/index.ts", "src/data", "src/hooking", "src/visualization"],
  "exclude": ["**/*.test.ts", "**/*.test.tsx", "src/test"]
}
